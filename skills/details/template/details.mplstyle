# Matplotlib style matching details.sty. Use: plt.style.use("details/details.mplstyle")

font.family: sans-serif
font.sans-serif: Source Sans 3, Source Sans Pro, DejaVu Sans
mathtext.fontset: stix
font.size: 9

axes.prop_cycle: cycler("color", ["0B6E6E", "C2732B", "2F5D8A", "5B6573"])
axes.edgecolor: 5B6573
axes.labelcolor: 1C2430
axes.titlesize: 10
axes.titleweight: bold
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.color: E3E8EC
grid.linewidth: 0.6

xtick.color: 5B6573
ytick.color: 5B6573
lines.linewidth: 1.4
legend.frameon: False

figure.figsize: 4.8, 3.0
figure.dpi: 150
savefig.format: pdf
savefig.bbox: tight
